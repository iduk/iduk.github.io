---
import ViewTransitionNames from '../components/ViewTransitionNames.astro';
import WorkListing from '../components/WorkListing.astro';
import Base from '../layouts/Base.astro';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';
import { getPublicProjects } from '../lib/projects';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const projects = await getPublicProjects();
const heading = t(locale, 'nav.work');
---
<Base title={`${heading} — iduk`} description={t(locale, 'work.index.description')} locale={locale}>
  <ViewTransitionNames slot="head" slugs={projects.map((p) => p.slug)} />
  <WorkListing locale={locale} projects={projects} heading={heading} />
</Base>
