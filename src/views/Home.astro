---
import ViewTransitionNames from '../components/ViewTransitionNames.astro';
import WorkListing from '../components/WorkListing.astro';
import Base from '../layouts/Base.astro';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';
import { getPublicProjects } from '../lib/projects';
import { defaultOg } from '../lib/seo';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const projects = await getPublicProjects();
---
<Base
  title={t(locale, 'home.title')}
  description={t(locale, 'home.description')}
  locale={locale}
  ogImage={await defaultOg(locale)}
>
  <ViewTransitionNames slot="head" slugs={projects.map((p) => p.slug)} />
  <WorkListing locale={locale} projects={projects} heading={t(locale, 'nav.work')} />
</Base>
