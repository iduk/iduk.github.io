---
import ViewTransitionNames from '../components/ViewTransitionNames.astro';
import WorkListing from '../components/WorkListing.astro';
import Base from '../layouts/Base.astro';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';
import type { Project } from '../lib/schema';

interface Props {
  locale: Locale;
  tag: { id: string; name: { ko: string; en: string } };
  projects: Project[];
}
const { locale, tag, projects } = Astro.props;
const heading = tag.name[locale];
---
<Base title={`${heading} — iduk`} description={t(locale, 'work.tag.description')} locale={locale}>
  <ViewTransitionNames slot="head" slugs={projects.map((p) => p.slug)} />
  <WorkListing locale={locale} projects={projects} heading={heading} activeTag={tag.id} />
</Base>
