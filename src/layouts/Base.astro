---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ImageColors from '../components/ImageColors.astro';
import type { Locale } from '../lib/i18n';
import { localeFromPath, localizedPath, stripLocale, t } from '../lib/i18n';
import { OG_HEIGHT, OG_WIDTH } from '../lib/ogSize';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** OG 이미지(1200x630) 경로와 alt. 있으면 og:image* 와 twitter 큰 카드를 낸다. */
  ogImage?: { path: string; alt: string };
  ogType?: 'website' | 'article';
  /** 검색에 노출하지 않는 페이지(404). canonical·alternate·og:url도 내지 않는다. */
  noindex?: boolean;
  /** 언어 전환 링크가 가리킬 경로. 기본은 현재 경로(404는 `/`). */
  basePath?: string;
}

const { title, description, ogImage, ogType = 'website', noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const locale: Locale = Astro.props.locale ?? localeFromPath(pathname);
const basePath = Astro.props.basePath ?? stripLocale(pathname);
const site = Astro.site ?? new URL('https://iduk.co.kr');
const abs = (loc: Locale) => new URL(localizedPath(loc, basePath), site).href;
const ogLocale = { ko: 'ko_KR', en: 'en_US' } as const;
const other: Locale = locale === 'ko' ? 'en' : 'ko';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={abs(locale)} />}
    {!noindex && <link rel="alternate" hreflang="ko" href={abs('ko')} />}
    {!noindex && <link rel="alternate" hreflang="en" href={abs('en')} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs('ko')} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={abs(locale)} />}
    <meta property="og:site_name" content="iduk" />
    {ogImage && <meta property="og:image" content={new URL(ogImage.path, site).href} />}
    {ogImage && <meta property="og:image:width" content={String(OG_WIDTH)} />}
    {ogImage && <meta property="og:image:height" content={String(OG_HEIGHT)} />}
    {ogImage && <meta property="og:image:alt" content={ogImage.alt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/PretendardVariable.site.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline src="/theme-init.js"></script>
    <ImageColors />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'nav.skip')}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} basePath={basePath} />
  </body>
</html>
