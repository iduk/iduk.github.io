---
import { getImage } from 'astro:assets';
import { localeFromPath, t } from '../lib/i18n';
import { widthClass } from '../lib/imageColors';
import { hasLargerFull } from '../lib/imageWidths';
import { resolveImage } from '../lib/masters';
import Picture from './Picture.astro';

interface Props {
  /** images.json 키: `<post-slug>/<NN>-<slug>` */
  image: string;
  alt: string;
}

const { image, alt } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);

const { entry, master } = resolveImage(image);

// 틀은 데스크톱에서도 960 CSS px까지만 넓어진다. srcset은 원본 폭(최대 1920)까지 후보를 주므로
// 고해상도 화면은 선명한 변형을, 모바일 첫 로드는 sizes(--gutter와 같은 clamp)에 맞는 하나만 받는다.
const FRAME_MAX = 960;
const SRCSET_MAX = 1920;

// 원본 크기 파일은 틀 안 표시 폭보다 클 때만 링크로 연다(정적 /_astro 파일, JS 없음).
const full = hasLargerFull(entry.width, FRAME_MAX)
  ? await getImage({ src: master, width: entry.width, format: 'webp' })
  : undefined;
---
<figure class="longshot">
  <div class="cap">
    <div class={`wrap ${widthClass(entry.width)}`}>
      <div class="frame">
        <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="viewport" role="region" tabindex="0" aria-label={t(locale, 'longshot.label')}>
          <span class="edge edge-top" aria-hidden="true"></span>
          <Picture
            image={image}
            alt={alt}
            sizes={`min(calc(100vw - 2 * clamp(1.25rem, 4vw, 4rem)), ${FRAME_MAX}px)`}
            maxWidth={SRCSET_MAX}
            fallbackWidth={FRAME_MAX}
          />
          <span class="edge edge-bottom" aria-hidden="true"></span>
        </div>
      </div>
      {
        full && (
          <div class="actions">
            <a class="full" href={full.src}>
              {t(locale, 'longshot.full')}
            </a>
          </div>
        )
      }
    </div>
  </div>
</figure>

<style>
  .longshot {
    margin: 0;
    padding-inline: var(--gutter);
  }
  .cap {
    max-width: 960px;
    margin-inline: auto;
  }
  .wrap {
    margin-inline: auto;
  }
  .frame {
    --frame-line: color-mix(in srgb, var(--color-text) 22%, transparent);
    position: relative;
    margin-inline: auto;
    border: 1px solid var(--frame-line);
    border-radius: 0.5rem;
    background: var(--color-bg);
    overflow: hidden;
  }
  .bar {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    padding: 0 0.75rem;
    height: 1.75rem;
    border-bottom: 1px solid var(--frame-line);
    background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg));
  }
  .bar i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-text) 28%, transparent);
  }
  .viewport {
    height: min(80svh, 56rem);
    overflow-y: auto;
    overflow-x: hidden;
    /* 틀 끝에 닿으면 페이지가 이어서 스크롤된다. */
    overscroll-behavior: auto;
    /* 이미지가 불러오기 전에도 틀이 비어 보이지 않도록 한다. */
    background: color-mix(in srgb, var(--color-text) 4%, var(--color-bg));
  }
  .viewport:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  /* :has()를 쓸 수 있으면 포커스 링을 틀 바깥으로 옮겨 페이지 배경과의 대비로 보이게 한다. */
  @supports selector(:has(*)) {
    .viewport:focus-visible {
      outline: none;
    }
    .frame:has(.viewport:focus-visible) {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }
  }
  .actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }
  .full {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: var(--fs-meta);
    font-weight: var(--fw-meta);
    letter-spacing: var(--ls-meta);
    color: var(--color-muted);
    text-underline-offset: 0.25em;
  }
  .full:hover {
    color: var(--color-accent);
  }

  /* 가장자리 그림자는 스크롤을 따라 나타난다. 스크롤 영역 안의 높이 0 sticky 요소가 제자리를 지키고,
     그 안의 ::after가 그림자를 그린다. 미지원 브라우저나 모션 줄이기에서는 그림자만 없고
     내용은 그대로 쓸 수 있다. */
  .edge {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    @media not (prefers-reduced-motion: reduce) {
      .edge {
        display: block;
        position: sticky;
        z-index: 1;
        height: 0;
        pointer-events: none;
        --shade: color-mix(in srgb, var(--color-text) 30%, transparent);
      }
      .edge::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: 1.75rem;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(nearest block);
      }
      .edge-top {
        top: 0;
      }
      .edge-top::after {
        top: 0;
        background: linear-gradient(to bottom, var(--shade), transparent);
        animation-name: edge-in;
        animation-range: 0 3rem;
      }
      .edge-bottom {
        bottom: 0;
      }
      .edge-bottom::after {
        bottom: 0;
        background: linear-gradient(to top, var(--shade), transparent);
        animation-name: edge-out;
        animation-range: calc(100% - 3rem) 100%;
      }
    }
  }
  @keyframes edge-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes edge-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @media (forced-colors: active) {
    .frame {
      border-color: CanvasText;
    }
    .bar {
      border-bottom-color: CanvasText;
    }
    .edge {
      display: none;
    }
  }
</style>
