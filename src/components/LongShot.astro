---
import { getImage } from 'astro:assets';
import { localeFromPath, t } from '../lib/i18n';
import { widthClass } from '../lib/imageColors';
import { resolveImage } from '../lib/masters';
import Picture from './Picture.astro';

interface Props {
  /** images.json 키: `<post-slug>/<NN>-<slug>` */
  image: string;
  alt: string;
}

const { image, alt } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);

const { entry, master } = resolveImage(image);

// 틀 안 이미지는 960px 이하 변형으로 시작한다. 큰 파일은 "원본 크기로 보기"를 눌러야 받는다.
const INLINE_MAX = 960;
const FULL_MAX = 2560;

// 원본 크기 파일: 빌드가 만드는 정적 파일(/_astro/...)이라 JS 없이 같은 탭에서 열린다.
// 페이지의 srcset에는 넣지 않으므로 모바일 첫 로드에서 받지 않는다.
const full = await getImage({
  src: master,
  width: Math.min(FULL_MAX, entry.width),
  format: 'webp',
});
---
<figure class="longshot">
  <div class={`frame ${widthClass(entry.width)}`}>
    <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="viewport" role="region" tabindex="0" aria-label={t(locale, 'longshot.label')}>
      <span class="edge edge-top" aria-hidden="true"></span>
      <Picture
        image={image}
        alt={alt}
        sizes={`min(100vw, ${INLINE_MAX}px)`}
        maxWidth={INLINE_MAX}
      />
      <span class="edge edge-bottom" aria-hidden="true"></span>
    </div>
  </div>
  <figcaption class="actions">
    <a class="full" href={full.src}>{t(locale, 'longshot.full')}</a>
  </figcaption>
</figure>

<style>
  .longshot {
    margin: 0;
    padding-inline: var(--gutter);
  }
  .frame {
    --frame-line: color-mix(in srgb, var(--color-text) 22%, transparent);
    position: relative;
    margin-inline: auto;
    border: 1px solid var(--frame-line);
    border-radius: 0.5rem;
    background: var(--color-bg);
    overflow: hidden;
  }
  .bar {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    padding: 0 0.75rem;
    height: 1.75rem;
    border-bottom: 1px solid var(--frame-line);
    background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg));
  }
  .bar i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-text) 28%, transparent);
  }
  .viewport {
    height: min(80svh, 56rem);
    overflow-y: auto;
    overflow-x: hidden;
    /* 틀 끝에 닿으면 페이지가 이어서 스크롤된다. */
    overscroll-behavior: auto;
    /* 이미지가 불러오기 전에도 틀이 비어 보이지 않도록 한다. */
    background: color-mix(in srgb, var(--color-text) 4%, var(--color-bg));
  }
  .viewport:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  .actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
    margin-inline: auto;
  }
  .full {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: var(--fs-meta);
    font-weight: var(--fw-meta);
    letter-spacing: var(--ls-meta);
    color: var(--color-muted);
    text-underline-offset: 0.25em;
  }
  .full:hover {
    color: var(--color-accent);
  }

  /* 가장자리 그림자는 스크롤을 따라 나타난다. 스크롤 영역 안의 높이 0 sticky 요소가 제자리를 지키고,
     그 안의 ::after가 그림자를 그린다. 미지원 브라우저나 모션 줄이기에서는 그림자만 없고
     내용은 그대로 쓸 수 있다. */
  .edge {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    @media not (prefers-reduced-motion: reduce) {
      .edge {
        display: block;
        position: sticky;
        z-index: 1;
        height: 0;
        pointer-events: none;
        --shade: color-mix(in srgb, var(--color-text) 30%, transparent);
      }
      .edge::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: 1.75rem;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(nearest block);
      }
      .edge-top {
        top: 0;
      }
      .edge-top::after {
        top: 0;
        background: linear-gradient(to bottom, var(--shade), transparent);
        animation-name: edge-in;
        animation-range: 0 3rem;
      }
      .edge-bottom {
        bottom: 0;
      }
      .edge-bottom::after {
        bottom: 0;
        background: linear-gradient(to top, var(--shade), transparent);
        animation-name: edge-out;
        animation-range: calc(100% - 3rem) 100%;
      }
    }
  }
  @keyframes edge-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes edge-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @media (forced-colors: active) {
    .frame {
      border-color: CanvasText;
    }
    .bar {
      border-bottom-color: CanvasText;
    }
    .edge {
      display: none;
    }
  }
</style>
