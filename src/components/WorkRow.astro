---
import { getCollection } from 'astro:content';
import type { Locale } from '../lib/i18n';
import { localizedPath } from '../lib/i18n';
import { transitionClass } from '../lib/lists';
import type { Project } from '../lib/schema';
import Picture from './Picture.astro';

interface Props {
  project: Project;
  locale: Locale;
  /** true: 글자 행 + 데스크톱 호버 미리보기(목록). false: 큰 이미지 행(홈). */
  withPreview?: boolean;
  /** 큰 이미지 행에서 첫 이미지만 즉시 불러온다. */
  priority?: boolean;
}
const { project, locale, withPreview = false, priority = false } = Astro.props;

const tagNames = new Map((await getCollection('tags')).map((e) => [e.data.id, e.data.name]));
const tags = project.tags.map((id) => tagNames.get(id)?.[locale] ?? id).join(' · ');
const href = localizedPath(locale, `/work/${project.slug}/`);
const cover = project.cover;
---
<li class:list={['row', withPreview ? 'compact' : 'big', !withPreview && !priority && 'reveal']} data-work-row>
  <a class="link" href={href} data-work-link>
    {
      withPreview ? (
        <>
          <span class="name reveal" data-work-title>
            {project.title[locale]}
          </span>
          <span class="tags reveal">{tags}</span>
          <span class="preview" aria-hidden="true">
            <span class:list={['frame', transitionClass(project.slug)]}>
              <Picture
                image={cover.image}
                alt=""
                sizes="26rem"
                maxWidth={960}
                fallbackWidth={640}
              />
            </span>
          </span>
        </>
      ) : (
        <>
          {/* 행 전체가 제목을 포함한 링크이므로 이미지는 장식이다(이름이 두 번 읽히지 않게). */}
          <span class:list={['cover', 'zoom', transitionClass(project.slug)]}>
            <Picture
              image={cover.image}
              alt=""
              sizes="100vw"
              priority={priority}
            />
          </span>
          <span class="caption">
            <span class="year">{project.year}</span>
            <span class="name" data-work-title>
              {project.title[locale]}
            </span>
            <span class="tags">{tags}</span>
          </span>
        </>
      )
    }
  </a>
</li>

<style>
  .row {
    list-style: none;
  }
  .link {
    display: block;
    min-width: 0;
    text-decoration: none;
  }
  .name {
    display: block;
    min-width: 0;
    font-size: var(--fs-sub);
    font-weight: var(--fw-sub);
    line-height: var(--lh-sub);
    letter-spacing: var(--ls-sub);
    overflow-wrap: anywhere;
  }
  .tags,
  .year {
    color: var(--color-muted);
    font-size: var(--fs-meta);
    font-weight: var(--fw-meta);
    line-height: var(--lh-meta);
    letter-spacing: var(--ls-meta);
  }
  .tags {
    display: block;
    overflow-wrap: anywhere;
  }
  .link:hover .name,
  .link:focus-visible .name {
    color: var(--color-accent);
  }

  /* 큰 이미지 행(홈) */
  .big .cover {
    display: block;
    overflow: hidden;
  }
  .big .cover :global(.pic) {
    margin-inline: auto;
  }
  .caption {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem 2rem;
    padding: 1rem var(--gutter) 0;
  }
  @media (min-width: 48rem) {
    .caption {
      grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 16rem);
      align-items: baseline;
    }
    .caption .tags {
      text-align: right;
    }
  }

  /* 글자 행(목록) */
  .compact .link {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem 2rem;
    min-height: var(--tap-min);
    padding: 0.75rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-muted) 35%, transparent);
  }
  .compact .name {
    font-size: clamp(1.375rem, 1rem + 1.6vw, 2.25rem);
  }
  .preview {
    display: none;
  }
  @media (min-width: 48rem) {
    .compact .link {
      grid-template-columns: minmax(0, 1fr) minmax(0, 14rem);
      align-items: baseline;
    }
    .compact .tags {
      text-align: right;
    }
  }
  /* 호버 미리보기는 부가 장식이다. 정보는 모두 글자 행에 있다. */
  @media (hover: hover) and (pointer: fine) and (min-width: 64rem) {
    .preview {
      position: absolute;
      z-index: 10;
      top: 50%;
      right: 16rem;
      width: 26rem;
      max-height: 24rem;
      overflow: hidden;
      transform: translateY(-50%);
      pointer-events: none;
      box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.25);
    }
    .link:hover .preview,
    .link:focus-visible .preview {
      display: block;
    }
    .frame {
      display: block;
    }
  }
</style>
