---
import { Picture as AstroPicture } from 'astro:assets';
import { colorClass, widthClass } from '../lib/imageColors';
import { intrinsicSize, srcsetWidths } from '../lib/imageWidths';
import { resolveImage } from '../lib/masters';

interface Props {
  /** images.json 키: `<post-slug>/<NN>-<slug>` */
  image: string;
  alt: string;
  sizes: string;
  priority?: boolean;
  /** srcset에 넣을 가장 큰 폭(px). */
  maxWidth?: number;
  /** 폴백 src와 width/height 속성의 폭(px). srcset 지원 브라우저는 쓰지 않는다. 비율은 원본 그대로. */
  fallbackWidth?: number;
}

const {
  image,
  alt,
  sizes,
  priority = false,
  maxWidth = Number.POSITIVE_INFINITY,
  fallbackWidth = Number.POSITIVE_INFINITY,
} = Astro.props;

const { entry, master } = resolveImage(image);

const widths = srcsetWidths(entry.width, maxWidth);
const { width, height } = intrinsicSize(entry, fallbackWidth);
---
<AstroPicture
  src={master}
  alt={alt}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? undefined : 'async'}
  fetchpriority={priority ? 'high' : undefined}
  class={`pic ${colorClass(entry.avgColor)} ${widthClass(entry.width)}`}
/>

<style is:global>
  .pic {
    display: block;
    /* 열 폭까지 채우되 .mw-<원본 폭>(ImageColors)이 원본보다 커지는 것을 막는다.
       srcset의 w 기술자는 sizes 기준으로 본래 크기를 정하므로 width:auto로는 막을 수 없다. */
    width: 100%;
    height: auto;
  }
</style>
