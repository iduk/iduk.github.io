---
import type { Locale } from '../../lib/i18n';
import type { Block } from '../../lib/schema';
import DemoBlock from './DemoBlock.astro';
import ImageBlock from './ImageBlock.astro';
import LongShotBlock from './LongShotBlock.astro';
import PairBlock from './PairBlock.astro';
import TextBlock from './TextBlock.astro';

interface Props {
  block: Block;
  locale: Locale;
}
const { block, locale } = Astro.props;
---
{block.type === 'image' && <ImageBlock image={block.image} alt={block.alt[locale]} />}
{
  block.type === 'pair' && (
    <PairBlock images={block.images.map((i) => ({ image: i.image, alt: i.alt[locale] }))} />
  )
}
{block.type === 'text' && <TextBlock html={block.body[locale]} />}
{block.type === 'demo' && <DemoBlock demo={block.demo} locale={locale} />}
{block.type === 'longshot' && <LongShotBlock image={block.image} alt={block.alt[locale]} />}
