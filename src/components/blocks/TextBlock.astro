---
interface Props {
  /** 빌드 때 sanitizeBody(p, a, strong, em, ul, ol, li, br만 허용)를 거친 HTML */
  html: string;
}
// set:html은 콘텐츠가 변환 시점에 정화되었기 때문에만 안전하다. 사용자 입력을 넣지 말 것.
const { html } = Astro.props;
---
<div class="text-block reveal" set:html={html} />

<style>
  .text-block {
    max-width: var(--measure);
    padding-inline: var(--gutter);
    overflow-wrap: anywhere;
  }
  .text-block :global(p + p),
  .text-block :global(ul),
  .text-block :global(ol) {
    margin-top: 1em;
  }
  .text-block :global(ul),
  .text-block :global(ol) {
    padding-left: 1.25em;
  }
  .text-block :global(a) {
    color: var(--color-accent);
  }
</style>
