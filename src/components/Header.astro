---
import logoSvg from '../../public/brand/pixelduk.svg?raw';
import type { Locale } from '../lib/i18n';
import { localizedPath, t } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
// 요청을 늘리지 않으려고 HTML에 직접 넣는다. CSP 때문에 SVG 안의 <style>은 빼고 CSS는 아래 style에 둔다.
// 링크 이름(aria-label)이 있으므로 그림은 장식으로 숨긴다.
const mark = logoSvg
  .replace(/<style>[\s\S]*?<\/style>/, '')
  .replace('<title>iduk</title>', '')
  .replace('<svg ', '<svg class="logo-mark" aria-hidden="true" focusable="false" ');
const labels = {
  toggle: t(locale, 'theme.toggle'),
  system: t(locale, 'theme.system'),
  light: t(locale, 'theme.light'),
  dark: t(locale, 'theme.dark'),
};
---
<header class="site-header">
  <a class="logo" href={localizedPath(locale, '/')} aria-label={`iduk, ${t(locale, 'nav.home')}`}>
    <Fragment set:html={mark} />
    <span>iduk</span>
  </a>
  <nav class="nav" aria-label={t(locale, 'nav.primary')}>
    <a href={localizedPath(locale, '/work/')}>{t(locale, 'nav.work')}</a>
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      data-state="system"
      data-label-toggle={labels.toggle}
      data-label-system={labels.system}
      data-label-light={labels.light}
      data-label-dark={labels.dark}
      aria-label={`${labels.toggle}: ${labels.system}`}
      hidden
    >
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
        <circle cx="10" cy="10" r="6.5" />
        <path class="half" d="M10 3.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" />
        <circle class="full" cx="10" cy="10" r="6.5" fill="currentColor" />
      </svg>
    </button>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  type State = 'system' | 'light' | 'dark';
  const order: State[] = ['system', 'light', 'dark'];

  function read(): State {
    try {
      const v = localStorage.getItem('theme');
      if (v === 'light' || v === 'dark') return v;
    } catch {}
    return 'system';
  }

  function apply(state: State, persist: boolean) {
    if (state === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', state);
    if (persist) {
      try {
        if (state === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', state);
      } catch {}
    }
    if (button) {
      button.dataset.state = state;
      const name = button.dataset[`label${state[0].toUpperCase()}${state.slice(1)}`];
      button.setAttribute('aria-label', `${button.dataset.labelToggle}: ${name}`);
    }
  }

  if (button) {
    button.hidden = false;
    apply(read(), false);
    button.addEventListener('click', () => {
      const current = (button.dataset.state as State) ?? 'system';
      apply(order[(order.indexOf(current) + 1) % order.length], true);
    });
  }
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--gutter);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap-min);
    font-size: 1.5rem;
    font-weight: var(--fw-hero);
    letter-spacing: var(--ls-sub);
    text-decoration: none;
  }
  /* 로고는 화면 높이에 비례한다(letsby는 8vh). 모바일은 세로가 길어 상한을 낮게, 데스크톱은 크게, 폭이 좁은 태블릿 세로는 폭 기준(7vw)으로 줄인다. */
  .logo :global(.logo-mark) {
    display: block;
    width: clamp(2.5rem, 6vh, 3rem);
    height: clamp(2.5rem, 6vh, 3rem);
  }
  @media (min-width: 48rem) {
    .logo :global(.logo-mark) {
      width: clamp(3.5rem, min(8vh, 7vw), 6rem);
      height: clamp(3.5rem, min(8vh, 7vw), 6rem);
    }
  }
  /* 눈 깜빡임. 모션 줄임 설정이면 멈춘다. */
  .logo :global(.logo-mark .b) {
    animation: logo-blink 2s linear infinite;
  }
  @keyframes logo-blink {
    0%,
    45%,
    55%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(1px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo :global(.logo-mark .b) {
      animation: none;
    }
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-meta);
    font-weight: var(--fw-meta);
    letter-spacing: var(--ls-meta);
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0 0.75rem;
    text-decoration: none;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border: 0;
    background: none;
    cursor: pointer;
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle:hover {
    color: var(--color-accent);
  }
  .theme-toggle .full {
    display: none;
  }
  .theme-toggle[data-state='light'] .half {
    display: none;
  }
  .theme-toggle[data-state='dark'] .half {
    display: none;
  }
  .theme-toggle[data-state='dark'] .full {
    display: inline;
  }
</style>
